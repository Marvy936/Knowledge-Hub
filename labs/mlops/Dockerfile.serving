FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    MLOPS_DEPLOYMENT_MANIFEST=/runtime/deployment.json \
    MLOPS_ARTIFACT_DIR=/runtime/artifact

WORKDIR /app

COPY labs/machine-learning/pyproject.toml /opt/knowledge-hub/machine-learning/pyproject.toml
COPY labs/machine-learning/README.md /opt/knowledge-hub/machine-learning/README.md
COPY labs/machine-learning/src /opt/knowledge-hub/machine-learning/src
COPY labs/mlops/pyproject.toml /opt/knowledge-hub/mlops/pyproject.toml
COPY labs/mlops/README.md /opt/knowledge-hub/mlops/README.md
COPY labs/mlops/src /opt/knowledge-hub/mlops/src

RUN python -m pip install --no-cache-dir --upgrade pip \
    && python -m pip install --no-cache-dir \
       /opt/knowledge-hub/machine-learning \
       "/opt/knowledge-hub/mlops[serving]" \
    && useradd --create-home --uid 10001 --shell /usr/sbin/nologin appuser \
    && chown -R appuser:appuser /app

USER 10001:10001

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=20s --retries=3 \
  CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/healthz', timeout=2).read()"]

CMD ["uvicorn", "mlops_lab.serving_app:app", "--host", "0.0.0.0", "--port", "8080", "--workers", "1", "--no-access-log"]
