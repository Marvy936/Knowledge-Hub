#!/usr/bin/env python3
# Intentionally unsafe: green control plane plus nonzero replicas is treated as capacity proof.
import json
from pathlib import Path

ROOT = Path.cwd()
contract = json.loads((ROOT / "serving-contract.json").read_text())
runtime = json.loads((ROOT / "runtime-state.json").read_text())
traffic = json.loads((ROOT / "traffic-evidence.json").read_text())
ready = runtime.get("control_plane_ready") is True and runtime.get("observed_ready_replicas", 0) > 0
report = {
    "capacity_subject_id": contract["capacity_subject_id"],
    "decision": "accepted" if ready else "blocked",
    "capacity_verified": ready,
    "observed_ready_replicas": runtime.get("observed_ready_replicas", 0),
    "fallback_rate": round(traffic.get("fallback_requests", 0) / max(traffic.get("requests", 1), 1), 6),
    "rollout_authorized": ready,
    "promotion_authorized": False,
    "retraining_authorized": False,
    "reason": "control_plane_ready_and_replicas_scaled" if ready else "not_ready"
}
(ROOT / "capacity-report.json").write_text(json.dumps(report, indent=2) + "\n")
print(report["decision"] + " / " + report["reason"])
