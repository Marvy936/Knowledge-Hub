#!/usr/bin/env bash
set -euo pipefail
FILE="${LAB_WORKSPACE:-/workspace}/.hint-level"
level=0
[[ -f "$FILE" ]] && level="$(cat "$FILE")"
level=$((level + 1))
echo "$level" > "$FILE"

case "$level" in
  1) echo "Hint 1: run 'cat scenario.env' and use those three values in the token request." ;;
  2) echo "Hint 2: the endpoint ends with /protocol/openid-connect/token and the grant type is client_credentials." ;;
  3) echo "Hint 3: curl -s -X POST http://127.0.0.1:8080/realms/$REALM/protocol/openid-connect/token -d grant_type=client_credentials -d client_id=$CLIENT_ID -d client_secret=$CLIENT_SECRET" ;;
  *) echo "Hint 4: pipe the JSON response through 'jq -r .access_token > token.txt', then run 'decode-jwt token.txt' and 'check'." ;;
esac
