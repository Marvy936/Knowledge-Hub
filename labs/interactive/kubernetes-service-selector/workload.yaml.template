apiVersion: v1
kind: Namespace
metadata:
  name: kh-selector
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: kh-web
  namespace: kh-selector
spec:
  replicas: 2
  selector:
    matchLabels:
      app: kh-web
  template:
    metadata:
      labels:
        app: kh-web
    spec:
      containers:
        - name: web
          image: busybox:1.36
          command:
            - /bin/sh
            - -ec
            - |
              mkdir -p /www
              printf 'selector-ok\n' > /www/index.html
              exec httpd -f -p 8080 -h /www
          ports:
            - containerPort: 8080
          readinessProbe:
            httpGet:
              path: /
              port: 8080
            initialDelaySeconds: 1
            periodSeconds: 2
