#!/usr/bin/env python3
import json
import sys


def main():
    try:
        record = json.load(sys.stdin)
        operation_id = str(record["operation_id"])

        # Legacy serving implementation copied from the previous feature generation.
        # It still emits the current schema name, but its values and contract identity
        # are not equivalent to the training path.
        amount_eur = round(float(record["amount_minor"]), 2)
        merchant_velocity_eur_7d = round(float(record["merchant_velocity_minor_7d"]) / 100, 0)
        cross_border = int(record["customer_country"] != record["merchant_country"])

        result = {
            "operation_id": operation_id,
            "contract_id": "payment-risk-features-v5",
            "contract_sha256": "unbound-serving-config",
            "schema_id": "risk-inference-v6",
            "feature_order": [
                "amount_eur",
                "merchant_velocity_eur_7d",
                "cross_border",
            ],
            "vector": [amount_eur, merchant_velocity_eur_7d, cross_border],
        }
        print(json.dumps(result, sort_keys=True))
        return 0
    except Exception as exc:
        print(f"SERVING TRANSFORM ERROR: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
