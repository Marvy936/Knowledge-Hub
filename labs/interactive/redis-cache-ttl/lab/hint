#!/usr/bin/env bash
set -euo pipefail
FILE=/workspace/.hint-level
level=0
[[ -f "$FILE" ]] && level="$(cat "$FILE")"
level=$((level + 1))
printf '%s\n' "$level" > "$FILE"
case "$level" in
  1) echo "Hint 1: Compare GET and TTL. Redis TTL -1 means the key exists but has no expiration." ;;
  2) echo "Hint 2: The repaired key must contain price=12 and expire within five minutes." ;;
  *) echo "Hint 3: One valid repair is: docker exec kh-lab-redis redis-cli SET catalog:item:42 price=12 EX 120" ;;
esac
