#!/usr/bin/env bash
set -u
pass_count=0
fail_count=0
result() {
  if [[ "$1" == "1" ]]; then
    printf '[PASS] %s\n' "$2"
    pass_count=$((pass_count + 1))
  else
    printf '[FAIL] %s\n' "$2"
    fail_count=$((fail_count + 1))
  fi
}

value="$(docker exec kh-lab-redis redis-cli --raw GET catalog:item:42 2>/dev/null || true)"
ttl="$(docker exec kh-lab-redis redis-cli TTL catalog:item:42 2>/dev/null | tr -d '\r' || true)"

result "$([[ "$value" == "price=12" ]] && echo 1 || echo 0)" "Cache contains the current catalog value price=12"

valid_ttl=0
if [[ "$ttl" =~ ^[0-9]+$ ]] && (( ttl > 0 && ttl <= 300 )); then
  valid_ttl=1
fi
result "$valid_ttl" "Cache key has a bounded TTL between 1 and 300 seconds"

echo
if (( fail_count == 0 )); then
  echo "LAB COMPLETED"
  exit 0
fi

echo "LAB NOT COMPLETE"
echo "Use 'hint' if you need help."
exit 1
