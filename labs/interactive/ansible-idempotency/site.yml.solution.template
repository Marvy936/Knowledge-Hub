---
- name: Manage application configuration idempotently
  hosts: app
  gather_facts: false
  vars:
    config_path: "{{ target_file | default('/workspace/target/app.conf') }}"
  tasks:
    - name: Enforce application configuration
      ansible.builtin.copy:
        dest: "{{ config_path }}"
        content: "MODE=production\n"
        mode: "0644"
