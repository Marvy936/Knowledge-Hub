#!/usr/bin/env bash
set -euo pipefail

state=/workspace/.hint-level
level=0
[[ -f "$state" ]] && level="$(cat "$state")"
level=$((level + 1))
(( level > 3 )) && level=3
printf '%s\n' "$level" > "$state"

case "$level" in
  1) echo "Hint 1: idempotency means convergence: the first run may repair drift, while the next identical run should report changed=0." ;;
  2) echo "Hint 2: state: touch always refreshes timestamps, while state: file does not enforce the required file content." ;;
  3) echo "Hint 3: use a content-managing module such as ansible.builtin.copy to declare MODE=production and mode 0644." ;;
esac
