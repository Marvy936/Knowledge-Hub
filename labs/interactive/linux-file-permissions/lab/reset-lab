#!/usr/bin/env bash
set -euo pipefail

ensure_group() {
  getent group "$1" >/dev/null 2>&1 || addgroup -S "$1" >/dev/null
}
ensure_user() {
  if ! id "$1" >/dev/null 2>&1; then
    adduser -S -D -H -s /bin/sh -G "$2" "$1" >/dev/null
  fi
}

ensure_group kh-app
ensure_group kh-deploy
ensure_group kh-guest
ensure_user kh-app kh-app
ensure_user kh-deploy kh-deploy
ensure_user kh-guest kh-guest

mkdir -p /workspace/config
cp "$LAB_ROOT/app.conf.template" /workspace/config/app.conf
chown root:root /workspace/config/app.conf
chmod 0666 /workspace/config/app.conf
chmod 0755 /workspace/config
rm -f /workspace/.hint-level

echo "Linux permissions lab reset. Run: status"
