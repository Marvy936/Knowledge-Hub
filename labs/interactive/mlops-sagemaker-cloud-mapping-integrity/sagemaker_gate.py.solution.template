#!/usr/bin/env python3
import hashlib, json
from pathlib import Path

EXPECTED_CONTRACT_DIGEST="sha256:d11b6e0eca63c62e62a01dffa98e0c91bd704a7bf658aed5c3c061871d83efab"

def load(p): return json.loads(Path(p).read_text())
def digest(p): return "sha256:"+hashlib.sha256(Path(p).read_bytes()).hexdigest()
def canonical(o): return json.dumps(o,indent=2,sort_keys=True)+"\n"
def text_digest(s): return "sha256:"+hashlib.sha256(s.encode()).hexdigest()
def req(cond,msg,errors):
    if not cond: errors.append(msg)
def exact_write(path,text):
    p=Path(path)
    if p.exists() and p.read_text()!=text:
        raise SystemExit(f"conflicting durable state: {path}")
    p.write_text(text)

c=load("sagemaker-contract.json")
p=load("pipeline-evidence.json")
r=load("registry-evidence.json")
ept=load("endpoint-evidence.json")
m=load("monitor-evidence.json")
x=load("parity-evidence.json")
s=load("second-operation.json")
errors=[]

req(digest("sagemaker-contract.json")==EXPECTED_CONTRACT_DIGEST,"contract digest mismatch",errors)
req(c["authority"]=={"approved_is_evidence_only":True,"inservice_is_evidence_only":True,"promotion_authorized":False,"retraining_authorized":False,"rollout_authorized":False,"succeeded_is_evidence_only":True},"authority contract mismatch",errors)

for ev,name in ((p,"pipeline"),(r,"registry"),(ept,"endpoint"),(m,"monitor")):
    req(ev["account_id"]==c["aws"]["account_id"] and ev["region"]==c["aws"]["region"],f"{name} account/region mismatch",errors)

req(p["pipeline_name"]==c["pipeline"]["name"] and p["execution_arn"]==c["pipeline"]["execution_arn"],"pipeline identity mismatch",errors)
req(p["status"]=="Succeeded","pipeline execution did not succeed",errors)
req(p["definition_digest"]==c["pipeline"]["definition_digest"],"pipeline definition mismatch",errors)
req(p["sdk_lock_digest"]==c["pipeline"]["sdk_lock_digest"],"pipeline SDK lock mismatch",errors)
req(p["source_commit"]==c["release"]["source_commit"],"source commit mismatch",errors)
pi=p["processing_input"]
req(pi["s3_uri"]==c["data"]["s3_uri"],"processing S3 URI mismatch",errors)
req(pi["s3_version_id"]==c["data"]["s3_version_id"],"processing S3 version mismatch",errors)
req(pi["dataset_digest"]==c["data"]["dataset_digest"],"processing dataset digest mismatch",errors)
req(p["processing_image"]==c["images"]["processing_image"],"processing image is not exact ECR digest",errors)
req(p["training_image"]==c["images"]["training_image"],"training image is not exact ECR digest",errors)
req(p["training_status"]=="Completed","training job did not complete",errors)
req(p["model_artifact_digest"]==c["release"]["model_artifact_digest"],"training output digest mismatch",errors)

req(r["model_package_group"]==c["registry"]["model_package_group"],"Model Package Group mismatch",errors)
req(r["model_package_arn"]==c["registry"]["model_package_arn"],"Model Package ARN mismatch",errors)
req(r["approval_status"]=="Approved","Model Package not Approved",errors)
req(r["model_artifact_digest"]==c["release"]["model_artifact_digest"],"Model Package artifact digest mismatch",errors)
req(bool(r["model_artifact_version_id"]),"Model Package artifact lacks S3 version identity",errors)
req(r["inference_image"]==c["images"]["inference_image"],"Model Package inference image is not exact ECR digest",errors)
req(r["evaluation_verdict"]=="passed","Model Package evaluation failed",errors)

req(ept["endpoint_arn"]==c["serving"]["endpoint_arn"],"Endpoint ARN mismatch",errors)
req(ept["status"]=="InService","Endpoint not InService",errors)
req(ept["endpoint_config_arn"]==c["serving"]["endpoint_config_arn"],"EndpointConfig mismatch",errors)
req(ept["model_arn"]==c["serving"]["model_arn"],"SageMaker Model ARN mismatch",errors)
req(ept["variant_name"]==c["serving"]["variant_name"],"production variant mismatch",errors)
req(ept["loaded_model_package_arn"]==c["registry"]["model_package_arn"],"loaded Model Package mismatch",errors)
req(ept["loaded_model_digest"]==c["release"]["model_artifact_digest"],"loaded model digest mismatch",errors)
req(ept["loaded_inference_image"]==c["images"]["inference_image"],"loaded inference image mismatch",errors)
syn=ept["synthetic_request"]
req(syn["http_status"]==200 and syn["result_class"]=="success","synthetic invocation failed",errors)
req(syn["release_id"]==c["release"]["release_id"],"synthetic release identity mismatch",errors)
req(syn["model_digest"]==c["release"]["model_artifact_digest"],"synthetic model identity mismatch",errors)
req(syn["variant"]==c["serving"]["variant_name"],"synthetic variant mismatch",errors)
req(ept["actual_exposure_reconciled"] is True,"actual endpoint exposure not reconciled",errors)
req(ept["successful_invocations"]+ept["failed_invocations"]==ept["actual_invocations"],"endpoint result classes do not reconcile",errors)

req(m["schedule_name"]==c["monitoring"]["schedule_name"],"Monitor schedule mismatch",errors)
req(m["status"]=="Completed","Monitor schedule did not complete",errors)
req(m["endpoint_arn"]==c["serving"]["endpoint_arn"] and m["variant_name"]==c["serving"]["variant_name"],"Monitor target mismatch",errors)
req(m["baseline_feature_generation"]==c["monitoring"]["baseline_feature_generation"],"Monitor feature generation mismatch",errors)
req(m["baseline_dataset_digest"]==c["monitoring"]["baseline_dataset_digest"],"Monitor baseline digest mismatch",errors)
req(m["capture_enabled"] is True and m["capture_coverage"]>=0.95,"monitoring capture coverage insufficient",errors)
req(m["label_maturity_complete"] is True,"monitor labels are not mature",errors)

req(x["kubernetes_release_id"]==c["release"]["kubernetes_release_id"],"Kubernetes source release mismatch",errors)
req(x["kubernetes_model_digest"]==c["release"]["model_artifact_digest"],"Kubernetes model digest mismatch",errors)
req(x["kubernetes_inference_image"]==c["images"]["inference_image"],"Kubernetes inference image mismatch",errors)
req(x["aws_release_id"]==c["release"]["release_id"],"AWS release id mismatch",errors)
req(x["aws_loaded_model_digest"]==c["release"]["model_artifact_digest"],"AWS/Kubernetes model parity failed",errors)
req(x["aws_loaded_inference_image"]==c["images"]["inference_image"],"AWS/Kubernetes image parity failed",errors)
req(x["same_model_bytes"] is True and x["same_acceptance_subject"] is True,"cross-platform acceptance semantics diverge",errors)

req(s["subject_id"]==c["release"]["release_id"] and s["same_subject"] is True,"second operation subject mismatch",errors)
if s["model_package_mutation_result"]=="timeout_unknown":
    req(s["model_package_read_before_retry"] is True,"Model Package timeout not reconciled before retry",errors)
if s["endpoint_mutation_result"]=="timeout_unknown":
    req(s["endpoint_read_before_retry"] is True,"Endpoint timeout not reconciled before retry",errors)
req(s["duplicate_model_package_created"] is None,"duplicate Model Package created",errors)
req(s["duplicate_endpoint_update_submitted"] is False,"duplicate Endpoint update submitted",errors)
req(s["loaded_state_reconciled"] is True,"second operation loaded state not reconciled",errors)

ok=not errors
report={"subject_id":c["release"]["release_id"],"sagemaker_mapping_verified":ok,"pipeline_verified":ok,"registry_verified":ok,"endpoint_verified":ok,"monitoring_verified":ok,"cross_platform_parity_verified":ok,"second_operation_verified":ok,"errors":errors,"rollout_authorized":False,"promotion_authorized":False,"retraining_authorized":False}
rt=canonical(report)
exact_write("sagemaker-report.json",rt)
if not ok:
    raise SystemExit("SAGEMAKER MAPPING REJECTED: "+"; ".join(errors))
ledger={"subject_id":c["release"]["release_id"],"contract_digest":digest("sagemaker-contract.json"),"pipeline_digest":digest("pipeline-evidence.json"),"registry_digest":digest("registry-evidence.json"),"endpoint_digest":digest("endpoint-evidence.json"),"monitor_digest":digest("monitor-evidence.json"),"parity_digest":digest("parity-evidence.json"),"second_operation_digest":digest("second-operation.json"),"report_digest":text_digest(rt)}
exact_write("sagemaker-evidence-ledger.json",canonical(ledger))
print("SAGEMAKER MAPPING VERIFIED")
