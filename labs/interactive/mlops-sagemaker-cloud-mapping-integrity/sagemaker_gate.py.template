#!/usr/bin/env python3
import json
from pathlib import Path

p=json.loads(Path("pipeline-evidence.json").read_text())
r=json.loads(Path("registry-evidence.json").read_text())
e=json.loads(Path("endpoint-evidence.json").read_text())
ok=p["status"]=="Succeeded" and r["approval_status"]=="Approved" and e["status"]=="InService"
report={"subject_id":"fraud-aws-2026-10-r50","sagemaker_mapping_verified":ok,"rollout_authorized":ok,"promotion_authorized":False,"retraining_authorized":False}
Path("sagemaker-report.json").write_text(json.dumps(report,indent=2,sort_keys=True)+"\n")
print("SAGEMAKER ACCEPTED" if ok else "SAGEMAKER BLOCKED")
