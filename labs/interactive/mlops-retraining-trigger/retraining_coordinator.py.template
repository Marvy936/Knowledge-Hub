#!/usr/bin/env python3
import argparse, json
from pathlib import Path

p = argparse.ArgumentParser()
p.add_argument('--contract', required=True)
p.add_argument('--trigger', required=True)
p.add_argument('--readiness', required=True)
p.add_argument('--ledger', required=True)
p.add_argument('--request', required=True)
a = p.parse_args()
contract = json.loads(Path(a.contract).read_text())
trigger = json.loads(Path(a.trigger).read_text())
readiness = json.loads(Path(a.readiness).read_text())
latest = trigger['windows'][-1]
recall_drop = latest['baseline_recall'] - latest['observed_recall']
if recall_drop >= contract['trigger_policy']['recall_drop_min']:
    request = {
        'retraining_subject_id': contract['retraining_subject_id'],
        'model_family': contract['model_family'],
        'baseline_release': contract['baseline_release'],
        'dataset_generation_id': readiness['dataset_generation_id'],
        'trigger': 'performance_degradation',
        'promotion_authorized': True
    }
    Path(a.request).write_text(json.dumps(request, indent=2, sort_keys=True) + '\n')
    print(json.dumps({'decision':'start_training','reason':'latest_window_recall_drop','promotion_authorized':True}, sort_keys=True))
else:
    print(json.dumps({'decision':'no_op','reason':'no_recall_drop','promotion_authorized':False}, sort_keys=True))
