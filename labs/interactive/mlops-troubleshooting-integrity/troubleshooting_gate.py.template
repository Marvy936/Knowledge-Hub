#!/usr/bin/env python3
import json
from pathlib import Path

r=json.loads(Path("containment-recovery.json").read_text())
ok=r["recovery"]["p99_recovered"] is True and r["recovery"]["actual_traffic_verified"] is True
report={
  "incident_id":"MLOPS-PAY-98-r51",
  "troubleshooting_verified":ok,
  "rollout_authorized":ok,
  "promotion_authorized":False,
  "retraining_authorized":False
}
Path("troubleshooting-report.json").write_text(json.dumps(report,indent=2,sort_keys=True)+"\n")
print("TROUBLESHOOTING ACCEPTED" if ok else "TROUBLESHOOTING BLOCKED")
