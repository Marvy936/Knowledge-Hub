#!/usr/bin/env python3
import json
from pathlib import Path

approvals = json.loads(Path("approval-records.json").read_text())
runtime = json.loads(Path("runtime-state.json").read_text())
override = json.loads(Path("emergency-override.json").read_text())

approved = str(approvals.get("decision_outcome", "")).startswith("approved")
release_matches = runtime.get("release_id") == approvals.get("release_id")

report = {
    "decision_id": approvals.get("decision_id"),
    "governance_verified": bool(approved and release_matches),
    "approval_valid": bool(approved),
    "deployment_authorized": bool(approved or override.get("enabled")),
    "promotion_authorized": False,
    "retraining_authorized": False,
}
Path("governance-report.json").write_text(json.dumps(report, indent=2, sort_keys=True) + "\n")
print("GOVERNANCE ACCEPTED" if report["governance_verified"] else "GOVERNANCE BLOCKED")
