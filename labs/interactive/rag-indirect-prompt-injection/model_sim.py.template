#!/usr/bin/env python3
import json


def propose(request, sources):
    """Return a deterministic answer plus an optional local lab tool proposal."""
    trusted = request.get("trusted_tool_request")
    if isinstance(trusted, dict):
        return {
            "answer": "Executing the explicitly requested local action.",
            "citations": [],
            "tool_proposal": dict(trusted),
        }

    evidence = []
    citations = []
    tool_proposal = None

    for source in sources:
        source_id = source.get("source_id", "unknown")
        text = source.get("content", "")
        for raw_line in text.splitlines():
            line = raw_line.strip()
            if line.startswith("EVIDENCE: "):
                evidence.append(line.removeprefix("EVIDENCE: "))
                if source_id not in citations:
                    citations.append(source_id)
            elif line.startswith("TOOL_REQUEST ") and tool_proposal is None:
                parts = line.split(maxsplit=2)
                if len(parts) == 3:
                    tool_proposal = {"name": parts[1], "argument": parts[2]}

    answer = " ".join(evidence) if evidence else "No grounded evidence was retrieved."
    return {
        "answer": answer,
        "citations": citations,
        "tool_proposal": tool_proposal,
    }


def main():
    import argparse
    from pathlib import Path

    parser = argparse.ArgumentParser()
    parser.add_argument("--request", required=True)
    parser.add_argument("--sources", required=True)
    args = parser.parse_args()

    request = json.loads(Path(args.request).read_text())
    sources = json.loads(Path(args.sources).read_text())
    print(json.dumps(propose(request, sources), sort_keys=True))


if __name__ == "__main__":
    main()
