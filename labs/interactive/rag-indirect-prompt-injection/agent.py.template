#!/usr/bin/env python3
import argparse
import json
from pathlib import Path

import model_sim
import policy

WORKSPACE = Path("/workspace").resolve()


def read_workspace_file(argument):
    target = Path(argument).resolve()
    try:
        target.relative_to(WORKSPACE)
    except ValueError as exc:
        raise ValueError("local lab tool is restricted to /workspace") from exc
    return target.read_text().strip()


def run(request_path, sources_path):
    request = json.loads(Path(request_path).read_text())
    sources = json.loads(Path(sources_path).read_text())
    proposal = model_sim.propose(request, sources)

    tool = proposal.get("tool_proposal")
    allowed, reason = policy.authorize_tool(request, tool)
    executed = False
    tool_result = None

    if tool is not None and allowed:
        if tool.get("name") != "read_file":
            allowed = False
            reason = "unsupported_tool"
        else:
            tool_result = read_workspace_file(tool.get("argument", ""))
            Path("/workspace/tool-executed.marker").write_text(
                json.dumps(tool, sort_keys=True) + "\n"
            )
            executed = True

    answer = proposal.get("answer", "")
    if executed:
        answer = f"{answer} Tool result: {tool_result}"

    result = {
        "answer": answer,
        "citations": proposal.get("citations", []),
        "tool_proposed": tool,
        "tool_allowed": bool(allowed),
        "tool_executed": executed,
        "tool_decision_reason": reason,
    }
    return result


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--request", required=True)
    parser.add_argument("--sources", required=True)
    args = parser.parse_args()
    print(json.dumps(run(args.request, args.sources), sort_keys=True))


if __name__ == "__main__":
    main()
