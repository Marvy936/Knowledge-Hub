#!/usr/bin/env python3
import argparse
import json
from pathlib import Path

def load(path):
    return json.loads(Path(path).read_text())

def write(path, value):
    Path(path).write_text(json.dumps(value, indent=2, sort_keys=True) + "\n")

def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--contract", required=True)
    parser.add_argument("--known-good", required=True)
    parser.add_argument("--exposure", required=True)
    parser.add_argument("--state", required=True)
    args = parser.parse_args()

    contract = load(args.contract)
    exposure = load(args.exposure)
    state = load(args.state)

    # BROKEN ON PURPOSE:
    # - trusts configured traffic instead of actual unit exposure;
    # - aggregates candidate + control requests;
    # - ignores feature fallback and action/review guardrails;
    # - treats a healthy aggregate as authority to ramp.
    rows = [r for r in exposure["records"] if r.get("eligible") is True]
    aggregate_error_rate = sum(1 for r in rows if r.get("error")) / len(rows)
    aggregate_latency = sum(float(r["latency_ms"]) for r in rows) / len(rows)

    if (
        contract["current_step"]["configured_candidate_exposure"] <= 0.20
        and aggregate_error_rate <= 0.10
        and aggregate_latency <= 200
    ):
        decision = "ramp"
        state["candidate_exposure"] = contract["next_step"]["candidate_exposure"]
        state["routing_generation"] = contract["next_step"]["state_generation"]
        state["status"] = "ramped"
    else:
        decision = "hold"

    state["last_decision"] = {"decision": decision, "basis": "aggregate_request_metrics"}
    write(args.state, state)
    print(json.dumps({
        "decision": decision,
        "configured_candidate_exposure": contract["current_step"]["configured_candidate_exposure"],
        "aggregate_error_rate": round(aggregate_error_rate, 6),
        "aggregate_latency_ms": round(aggregate_latency, 6),
    }, sort_keys=True))
    return 0

if __name__ == "__main__":
    raise SystemExit(main())
