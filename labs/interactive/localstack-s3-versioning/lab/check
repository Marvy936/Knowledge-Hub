#!/usr/bin/env bash
set -u
pass_count=0
fail_count=0
result() { if [[ "$1" == "1" ]]; then printf '[PASS] %s\n' "$2"; pass_count=$((pass_count+1)); else printf '[FAIL] %s\n' "$2"; fail_count=$((fail_count+1)); fi; }

versioning="$(aws s3api get-bucket-versioning --bucket kh-lab-bucket --query Status --output text 2>/dev/null || true)"
result "$([[ "$versioning" == "Enabled" ]] && echo 1 || echo 0)" "Bucket versioning is enabled"

rm -f /workspace/current.json
if aws s3api get-object --bucket kh-lab-bucket --key app/config.json /workspace/current.json >/dev/null 2>&1 && grep -q '"version":2' /workspace/current.json; then
  result 1 "Latest object body is version 2"
else
  result 0 "Latest object body is version 2"
fi

non_null_versions="$(aws s3api list-object-versions --bucket kh-lab-bucket --prefix app/config.json 2>/dev/null | jq '[.Versions[]? | select(.VersionId != "null")] | length' 2>/dev/null || echo 0)"
[[ "$non_null_versions" =~ ^[0-9]+$ ]] || non_null_versions=0
result "$(( non_null_versions >= 1 ))" "At least one real version ID exists for app/config.json"

echo
if (( fail_count == 0 )); then echo "LAB COMPLETED"; exit 0; fi
echo "LAB NOT COMPLETE"
echo "Use 'hint' if you need help."
exit 1
