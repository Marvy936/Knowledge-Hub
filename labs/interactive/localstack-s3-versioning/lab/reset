#!/usr/bin/env bash
set -euo pipefail
docker compose -f "$LAB_SCENARIO" --env-file "$LAB_ENV_FILE" down -v --remove-orphans >/dev/null 2>&1 || true
rm -f /workspace/.hint-level /workspace/current.json
docker compose -f "$LAB_SCENARIO" --env-file "$LAB_ENV_FILE" up -d >/dev/null
wait-ready
echo "Lab reset. Run: status"
