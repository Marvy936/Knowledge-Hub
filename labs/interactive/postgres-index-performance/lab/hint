#!/usr/bin/env bash
set -euo pipefail
level_file=/workspace/.hint-level
level=0
[[ -f "$level_file" ]] && level="$(cat "$level_file")"
level=$((level+1)); echo "$level" > "$level_file"
case "$level" in
  1) echo "Hint 1: run 'status' and look for Seq Scan in the target query plan." ;;
  2) echo "Hint 2: the WHERE clause filters on customer_id and status together." ;;
  *) echo "Hint 3: edit solution.sql with a composite index such as CREATE INDEX ... ON orders(customer_id, status); then run 'apply' and 'check'." ;;
esac
