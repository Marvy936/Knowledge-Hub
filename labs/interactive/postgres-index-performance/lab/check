#!/usr/bin/env bash
set -u
pass=0
fail=0
result(){ if [[ "$1" == 1 ]]; then echo "[PASS] $2"; pass=$((pass+1)); else echo "[FAIL] $2"; fail=$((fail+1)); fi; }

index_count="$(docker exec kh-lab-postgres-index psql -U labuser -d labdb -Atqc "SELECT count(*) FROM pg_indexes WHERE schemaname='public' AND tablename='orders' AND indexdef ILIKE '%customer_id%' AND indexdef ILIKE '%status%';" 2>/dev/null || echo 0)"
[[ "$index_count" =~ ^[0-9]+$ ]] && (( index_count > 0 )) && result 1 "Composite customer/status index exists" || result 0 "Composite customer/status index exists"

plan="$(docker exec kh-lab-postgres-index psql -U labuser -d labdb -Atqc "EXPLAIN (COSTS OFF) SELECT * FROM orders WHERE customer_id = 4240 AND status = 'paid';" 2>/dev/null || true)"
if grep -Eq 'Index Scan|Bitmap Index Scan' <<<"$plan"; then result 1 "Planner uses an index for the target query"; else result 0 "Planner uses an index for the target query"; fi

rows="$(docker exec kh-lab-postgres-index psql -U labuser -d labdb -Atqc "SELECT count(*) FROM orders WHERE customer_id = 4240 AND status = 'paid';" 2>/dev/null || echo 0)"
[[ "$rows" =~ ^[0-9]+$ ]] && (( rows > 0 )) && result 1 "Target query still returns the expected rows" || result 0 "Target query still returns the expected rows"

echo
if (( fail == 0 )); then echo "LAB COMPLETED"; exit 0; fi
echo "LAB NOT COMPLETE"
echo "Use 'hint' if you need help."
exit 1
