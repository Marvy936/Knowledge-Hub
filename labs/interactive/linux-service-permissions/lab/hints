#!/usr/bin/env bash
set -euo pipefail
state=/workspace/.hint-level
level=0
[[ -f "$state" ]] && level="$(cat "$state")"
level=$((level + 1))
(( level > 3 )) && level=3
printf '%s\n' "$level" > "$state"
case "$level" in
  1) echo "Hint 1: reading a file through a pathname requires access to both the directory and the file; inspect owner, group and mode on each." ;;
  2) echo "Hint 2: khapp should receive access through the khapp group while root remains the owner. The directory needs group traversal; the file needs group read." ;;
  3) echo "Hint 3: set group ownership to khapp on both objects, then use 0750 on secure and 0640 on secure/app.env." ;;
esac
