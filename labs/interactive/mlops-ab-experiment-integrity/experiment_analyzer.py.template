#!/usr/bin/env python3
import argparse
import json
from pathlib import Path


def load(path):
    return json.loads(Path(path).read_text())


def analyze(contract_path, evidence_path, state_path):
    contract = load(contract_path)
    evidence = load(evidence_path)
    state = load(state_path)

    # Intentionally unsafe: request-weighted mature rows, no randomization/SRM/
    # contamination/interference/fixed-horizon validation.
    mature = [r for r in evidence['records'] if r.get('eligible') and r.get('outcome_status') == 'mature']
    candidate = [r for r in mature if r.get('actual_release') == contract['candidate_release']]
    control = [r for r in mature if r.get('actual_release') == contract['control_release']]
    candidate_rate = sum(bool(r.get('converted')) for r in candidate) / max(1, len(candidate))
    control_rate = sum(bool(r.get('converted')) for r in control) / max(1, len(control))
    lift = candidate_rate - control_rate
    winner = lift >= contract['analysis_policy']['minimum_absolute_lift']

    result = {
        'experiment_subject_id': contract['experiment_subject_id'],
        'candidate_rate': round(candidate_rate, 6),
        'control_rate': round(control_rate, 6),
        'absolute_lift': round(lift, 6),
        'decision': 'winner_candidate' if winner else 'no_winner',
        'promotion_authorized': bool(winner),
    }
    state['status'] = 'candidate_winner' if winner else 'completed'
    state['last_analysis'] = result
    Path(state_path).write_text(json.dumps(state, indent=2, sort_keys=True) + '\n')
    if winner:
        Path('/workspace/promotion-request.json').write_text(json.dumps({
            'release_id': contract['candidate_release'],
            'authorized_by': contract['experiment_subject_id'],
        }, indent=2, sort_keys=True) + '\n')
    return result


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('--contract', required=True)
    parser.add_argument('--evidence', required=True)
    parser.add_argument('--state', required=True)
    args = parser.parse_args()
    print(json.dumps(analyze(args.contract, args.evidence, args.state), sort_keys=True))


if __name__ == '__main__':
    main()
