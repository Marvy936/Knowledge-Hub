#!/usr/bin/env python3
import argparse
import json
from pathlib import Path


def load_json(path: Path):
    return json.loads(path.read_text())


def write_json(path: Path, value):
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(value, indent=2, sort_keys=True) + "\n")


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--candidate", default="/workspace/candidate")
    parser.add_argument("--dataset", default="/workspace/evidence/eval-dataset.json")
    parser.add_argument("--policy", default="/workspace/promotion-policy.json")
    parser.add_argument("--release", default="/workspace/release/current.json")
    args = parser.parse_args()

    candidate = Path(args.candidate)
    manifest = load_json(candidate / "manifest.json")
    evaluation = load_json(candidate / "evaluation.json")
    policy = load_json(Path(args.policy))

    # Intentionally incomplete: one aggregate metric is not enough to prove
    # that the evaluated model is the exact subject being promoted.
    if evaluation["metrics"]["f1_score"] < policy["min_f1_score"]:
        print("PROMOTION DENIED: aggregate F1 below threshold")
        return 4

    release = {
        "release_id": "release-" + manifest["model_id"],
        "model_id": manifest["model_id"],
        "artifact_sha256": manifest["artifact_sha256"],
        "dataset_id": manifest["dataset_id"],
        "feature_schema_id": manifest["feature_schema_id"],
        "source_revision": manifest["source_revision"],
        "evaluation_id": evaluation["evaluation_id"],
    }
    write_json(Path(args.release), release)
    print("PROMOTED", release["release_id"])
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
