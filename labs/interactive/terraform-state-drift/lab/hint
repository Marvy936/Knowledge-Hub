#!/usr/bin/env bash
set -euo pipefail
FILE=/workspace/.hint-level
level=0
[[ -f "$FILE" ]] && level="$(cat "$FILE")"
level=$((level + 1))
printf '%s\n' "$level" > "$FILE"
case "$level" in
  1) echo "Hint 1: terraform plan refreshes the real resource and compares it with configuration/state." ;;
  2) echo "Hint 2: The configuration is already correct. The drift was introduced outside Terraform." ;;
  *) echo "Hint 3: Run terraform apply and review the proposed reconciliation before approving it." ;;
esac
