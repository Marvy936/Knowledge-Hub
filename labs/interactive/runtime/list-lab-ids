#!/usr/bin/env bash
set -euo pipefail

REGISTRY="/opt/knowledge-hub/runtime/labs.tsv"
PROFILE="${1:-}"

if [[ -z "$PROFILE" ]]; then
  cut -f1 "$REGISTRY" | sed '/^$/d'
  exit 0
fi

case "$PROFILE" in
  shell|docker|k3s) ;;
  *)
    echo "Unknown runtime profile: $PROFILE" >&2
    echo "Expected: shell, docker or k3s" >&2
    exit 2
    ;;
esac

awk -F $'\t' -v profile="$PROFILE" '$2 == profile { print $1 }' "$REGISTRY"
