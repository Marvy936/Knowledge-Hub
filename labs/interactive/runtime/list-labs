#!/usr/bin/env bash
set -euo pipefail

REGISTRY="/opt/knowledge-hub/runtime/labs.tsv"

echo "Knowledge Hub Interactive Labs"
echo
while IFS=$'\t' read -r id description; do
  [[ -n "$id" ]] || continue
  printf '  %-30s %s\n' "$id" "$description"
done < "$REGISTRY"
echo
echo "Run a lab with:"
echo "  docker run --pull=always --rm -it --privileged ghcr.io/marvy936/knowledge-hub-lab-docker-network-debug:latest <lab-id>"
echo
echo "Show a lab assignment without starting it:"
echo "  docker run --rm ghcr.io/marvy936/knowledge-hub-lab-docker-network-debug:latest <lab-id> help"
