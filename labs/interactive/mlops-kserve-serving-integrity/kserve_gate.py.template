#!/usr/bin/env python3
import json
from pathlib import Path

isvc=json.loads(Path("inferenceservice-evidence.json").read_text())
fleet=json.loads(Path("fleet-evidence.json").read_text())
ok=isvc["ready"] and fleet["synthetic_request"]["http_status"]==200
report={
  "subject_id": isvc["name"],
  "kserve_integrity_verified": ok,
  "rollout_authorized": ok,
  "promotion_authorized": False,
  "retraining_authorized": False
}
Path("kserve-report.json").write_text(json.dumps(report,indent=2,sort_keys=True)+"\n")
print("KSERVE ACCEPTED" if ok else "KSERVE BLOCKED")
