#!/usr/bin/env bash
set -euo pipefail
LAB_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
mkdir -p /workspace
cp "$LAB_ROOT/feedback_gate.py.template" /workspace/feedback_gate.py
cp "$LAB_ROOT/feedback-contract.json.template" /workspace/feedback-contract.json
cp "$LAB_ROOT/prediction-snapshot.json.template" /workspace/prediction-snapshot.json
