#!/usr/bin/env sh
set -eu
ROOT=/opt/knowledge-hub/labs/linux-isolation-integrity
reset_lab() { "$ROOT/lab/workspace-init"; }
case "${1:-help}" in
  help|lab-help)
    cat <<'HELP'
Knowledge Hub Interactive Lab
Lab: linux-isolation-integrity

Commands:
  status      Show isolation evidence/report state
  assess      Execute your current isolation_gate.py
  check       Validate your gate
  hint        Show the namespace/cgroup/capability boundary
  reset       Restore the unsafe label-only isolation incident
  self-test   Prove the fixture and reference solution
HELP
    ;;
  status)
    printf 'isolation_gate.py: '; [ -f isolation_gate.py ] && echo present || echo missing
    printf 'isolation-report.json: '; [ -f isolation-report.json ] && echo present || echo missing
    printf 'isolation-evidence-ledger.json: '; [ -f isolation-evidence-ledger.json ] && echo present || echo missing
    ;;
  hint) echo 'Do not trust the word container or UID 0. Compare namespace object IDs to the host, read effective cgroup limits, inspect post-exec capability sets and prove forbidden adjacent operations are denied.' ;;
  assess) python3 ./isolation_gate.py ;;
  check) python3 ./isolation_validator.py ;;
  reset) reset_lab; echo 'RESET COMPLETE' ;;
  self-test)
    reset_lab
    python3 ./isolation_gate.py >/dev/null
    python3 - <<'PY'
import json
from pathlib import Path
r=json.loads(Path('isolation-report.json').read_text())
assert r['isolation_verified'] is True
assert r['security_boundary_verified'] is True
PY
    for f in isolation-contract isolation-evidence cgroup-evidence capability-evidence operation-evidence second-operation; do
      cp "$ROOT/$f.json.template" "./$f.json"
    done
    cp "$ROOT/isolation_gate.py.solution.template" ./isolation_gate.py
    chmod +x ./isolation_gate.py
    rm -f isolation-report.json isolation-evidence-ledger.json
    python3 ./isolation_validator.py
    reset_lab
    echo 'SELF-TEST PASSED'
    ;;
  *) echo "unknown command: $1" >&2; exit 2 ;;
esac
