#!/usr/bin/env bash
set -euo pipefail
level_file=/workspace/.hint-level
level=0
[[ -f "$level_file" ]] && level="$(cat "$level_file")"
level=$((level+1)); echo "$level" > "$level_file"
case "$level" in
  1) echo "Hint 1: run 'status'. The backend is healthy, but the gateway exits during startup." ;;
  2) echo "Hint 2: read the gateway log and compare the upstream hostname in nginx.conf with the Compose service names." ;;
  *) echo "Hint 3: replace backend-api with backend in nginx.conf, then run 'apply' and 'check'." ;;
esac
